# Settings for the DUBBE website (dubbe-web). They are read from environment variables:
# set them in your shell or on the host. Never commit real values (.env is git-ignored).

# Where the site listens, and the address used in email links (set to the public https address when deployed)
DUBBE_HOST=127.0.0.1
DUBBE_PORT=8000
DUBBE_SITE_URL=http://127.0.0.1:8000

# Database, uploaded videos, dubs and the local mail outbox
DUBBE_WEB_DATA=data/web

# Comma-separated emails that can open /admin and have no plan limits
DUBBE_ADMINS=

# Where contact-form messages are emailed (they are stored in the database either way)
DUBBE_TEAM_EMAIL=

# 1 = run the dub worker inside the web process (one job at a time); 0 = do not
DUBBE_WORKER=1

# Email. Without SMTP_HOST, mails are written to data/web/outbox/ and printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DUBBE_MAIL_FROM=DUBBE <no-reply@example.com>

# Voice cloning (your own voice only; recordings stored encrypted). Without this key cloning is switched off.
# Make one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it is lost, the stored voice recordings cannot be read any more.
DUBBE_VOICE_KEY=
