%% Pipeline data flow: stages (boxes), files (rounded), quality signals (notes)
flowchart TB
    in(["input.mp4"])
    s1["1. extract<br/><i>ffmpeg</i>"]
    f1(["audio.wav (16 kHz)<br/>original.wav (44.1 kHz)"])
    s2["2. separate<br/><i>Demucs</i>"]
    f2(["background.wav<br/>vocals.wav"])
    s3["3. asr<br/><i>faster-whisper, word timestamps</i>"]
    f3(["words.json"])
    s4["4. segment<br/><i>sentence endings + pauses</i>"]
    f4(["segments.json<br/>one entry per sentence"])
    s5["5. voice<br/><i>pitch -> closest preset voice</i>"]
    s6["6. translate<br/><i>NLLB-200, 4 alternatives</i>"]
    s7["7. tts<br/><i>Kokoro (en) / MMS (ko)</i>"]
    f7(["tts/&lt;id&gt;.wav"])
    s8["8. shorten<br/><i>shorter alternative if too long</i>"]
    s9["9. timing<br/><i>anchor, speed-up &lt;= 1.3x,<br/>optional picture slow-down,<br/>loudness match</i>"]
    f9(["dub.wav"])
    s10["10. mux<br/><i>background ducked under voice</i>"]
    out(["dubbed.mp4"])
    s11["11. report"]
    rep(["report.html<br/>flagged segments"])
    rev["Reviewer fluent in<br/>the target language"]

    in --> s1 --> f1 --> s2 --> f2
    f1 --> s3 --> f3 --> s4 --> f4
    f2 --> s5 --> f4
    f4 --> s6 --> f4
    f4 --> s7 --> f7 --> s8 --> s9 --> f9 --> s10 --> out
    in --> s10
    f2 --> s10
    f4 --> s11 --> rep --> rev
    rev -- "edits translation or voice,<br/>re-runs --from tts" --> f4

    q3["ASR confidence:<br/>word probability"] -.- s3
    q6["Translation confidence:<br/>NLLB probability"] -.- s6
    q9["Stretch, slow-down,<br/>overflow"] -.- s9

    classDef stage fill:#1168bd,stroke:#0b4884,color:#fff
    classDef file fill:#eaf2fb,stroke:#438dd5,color:#0b3a66
    classDef signal fill:#fff4d6,stroke:#d9a400,color:#5c4400
    classDef person fill:#08427b,stroke:#052e56,color:#fff
    class s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11 stage
    class in,f1,f2,f3,f4,f7,f9,out,rep file
    class q3,q6,q9 signal
    class rev person
